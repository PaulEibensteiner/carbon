{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "scala",
            "request": "launch",
            "name": "Carbon Configurable Tests",
            "testClass": "viper.carbon.ConfigurableCarbonTests",
            "jvmOptions": [
                "-Xss128m",
                "-DCARBON_CONFIG_FILE=${input:carbonConfigFile}",
                "-DROOT_DIR=${workspaceFolder}/.."
            ],
            "envFile": "${workspaceFolder}/../msc-peibensteine/.env"
        },
        {
            "type": "scala",
            "request": "launch",
            "name": "Carbon Run",
            "mainClass": "viper.carbon.Carbon",
            "buildTarget": "carbon",
            "args": [
                "--proverStatisticsFile=/home/paul/master-thesis/msc-peibensteine/tryout-results/carb-statistics",
                "/home/paul/master-thesis/msc-peibensteine/tryout-targets/examples-11.1.vpr"
            ],
            "envFile": "${workspaceFolder}/../msc-peibensteine/.env"
        }
    ],
    "inputs": [
        {
            "id": "viperFile",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                "include": "tryout-targets/**/*.vpr",
                "description": "Select viper file",
                "fromWorkspace": "msc-peibensteine",
            }
        },
        {
            "id": "carbonConfigFile",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                "include": "backend-configs/vcg/*.json",
                "fromWorkspace": "msc-peibensteine",
                "description": "Select the backend config file"
            }
        }
    ]
}